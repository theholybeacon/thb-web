{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "npm pkg delete devDependencies.@andresrub10/cockpit && npm install",
	"crons": [
		{
			"path": "/api/cron/daily-emails",
			"schedule": "0 12 * * *"
		}
	],
	"git": {
		"deploymentEnabled": {
			"main": false,
			"dev": false,
			"staging": false
		}
	}
}
