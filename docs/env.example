# ---------------------------------------------------------------------------
# The Holy Beacon — environment template.
#
# Install with:   cp docs/env.example .env.example
# (Kept here because .env* files are write-protected in this workspace.)
#
# For local work: cp docs/env.example .env.local and fill in.
# NEVER commit .env.local — it points at the production database.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=

# --- Scripture text --------------------------------------------------------
# api.bible key. Backs verse/book/chapter hydration and one alignment source.
# The daily quota is shared by the reader, the warm script and the Content API.
BIBLE_API_KEY=
# Hour (UTC) at which that daily quota resets. Only `warm:bible --drain` reads
# it, to know when to stop so it cannot spend tomorrow's allowance. Default 0.
# api.bible does not publish the real hour — if it turns out not to be midnight
# UTC, set it here and move the cron in .github/workflows/warm-quota.yml.
WARM_QUOTA_RESET_HOUR_UTC=

# --- Auth (Clerk) ----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI (OpenAI) -----------------------------------------------------------
# Read implicitly by the OpenAI SDK. Backs study generation, character
# profiles, narration (TTS) and inferred word alignment.
OPENAI_API_KEY=

# --- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=

# --- Storage (Vercel Blob) -------------------------------------------------
# Narration MP3s, alignment corpora, profile pictures.
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# HMAC secret for stateless one-click unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# --- Cron ------------------------------------------------------------------
# Bearer token Vercel sends to /api/cron/daily-emails.
CRON_SECRET=
# Set to enable the hourly notification sweep.
CRON_HOURLY_SWEEP=

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- URLs / misc -----------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://theholybeacon.com
NEXT_PUBLIC_APP_URL=https://theholybeacon.com
DEFAULT_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Content API (docs/content-api.md)
#
# Read-only API consumed by our own tooling — above all the marketing pipeline.
# Not public.
# ---------------------------------------------------------------------------

# Comma-separated label:secret pairs, one per consumer, so rate limits and
# hydration budgets are per-client and logs name the client that misbehaved.
# Only the FIRST colon separates label from secret.
#   CONTENT_API_KEYS="marketing:<long-random-secret>,localdev:<another>"
# UNSET MEANS EVERY REQUEST IS REJECTED. That is intentional.
CONTENT_API_KEYS=

# Requests per minute per key. Default 60. In-process and per-instance:
# a courtesy brake, not a security control.
CONTENT_API_RATE_LIMIT_PER_MINUTE=60

# Cold chapters one key may pull from api.bible per UTC day. Default 200.
# Cached chapters are unmetered. Set 0 to forbid on-demand hydration entirely
# and serve only pre-warmed text (npm run warm:bible).
CONTENT_API_HYDRATION_BUDGET=200
